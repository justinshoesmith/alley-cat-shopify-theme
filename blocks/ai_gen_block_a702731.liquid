    {
      "type": "url",
      "id": "custom_link_1_url",
      "label": "Custom link 1 URL"
    },
    {
      "type": "text",
      "id": "custom_link_2_text",
      "label": "Custom link 2 text"
    },
    {
      "type": "url",
      "id": "custom_link_2_url",
      "label": "Custom link 2 URL"
    },
    {
      "type": "text",
      "id": "custom_link_3_text",
      "label": "Custom link 3 text"
    },
    {
      "type": "url",
      "id": "custom_link_3_url",
      "label": "Custom link 3 URL"
