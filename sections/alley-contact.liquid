{{ 'alley-cat-contact.css' | asset_url | stylesheet_tag }}

<section class="alley-contact" aria-labelledby="alley-contact-title">
  <div class="container">
    <header class="alley-contact__intro">
      <p class="alley-contact__eyebrow">We're here to help</p>
      <h1 id="alley-contact-title">{{ section.settings.heading | escape }}</h1>
      <div class="alley-contact__lead rte">{{ section.settings.intro }}</div>
    </header>

    <div class="alley-contact__grid">
      <div class="alley-contact__information">
        <div class="alley-contact__panel">
          <h2>Get in touch</h2>
          {% if section.settings.phone != blank %}
            <div class="alley-contact__item">
              <h3>Phone</h3>
              <p><a href="tel:{{ section.settings.phone | remove: ' ' | escape }}">{{ section.settings.phone | escape }}</a></p>
            </div>
          {% endif %}
          {% if section.settings.postal_address != blank %}
            <div class="alley-contact__item">
              <h3>Postal address</h3>
              <p>{{ section.settings.postal_address | escape | newline_to_br }}</p>
            </div>
          {% endif %}
          {% if section.settings.hours != blank %}
            <div class="alley-contact__item">
              <h3>Online customer care</h3>
              <p>{{ section.settings.hours | escape }}</p>
            </div>
          {% endif %}
        </div>

        <div class="alley-contact__panel">
          <h2>Quick links</h2>
          <ul class="alley-contact__links">
            {% if section.settings.returns_url != blank %}
              <li><a href="{{ section.settings.returns_url }}">Returns &amp; refunds policy</a></li>
            {% endif %}
            {% if section.settings.faq_url != blank %}
              <li><a href="{{ section.settings.faq_url }}">FAQs</a></li>
            {% endif %}
          </ul>
        </div>
      </div>

      <div class="alley-contact__panel alley-contact__form-panel">
        <h2>Send us a message</h2>
        <p>For product, order and general enquiries. We reply during online customer care hours.</p>
        {% form 'contact', id: 'AlleyContactForm', class: 'alley-contact__form' %}
          {% if form.posted_successfully? %}
            <p class="alley-contact__notice" role="status">Thanks for your message. Our customer care team will be in touch.</p>
          {% endif %}
          {% if form.errors %}
            <div class="alley-contact__error" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <div class="alley-contact__field">
            <label for="AlleyContactName">Name</label>
            <input id="AlleyContactName" type="text" name="contact[name]" autocomplete="name" value="{{ form.name | default: customer.name | escape }}" required>
          </div>
          <div class="alley-contact__field">
            <label for="AlleyContactEmail">Email</label>
            <input id="AlleyContactEmail" type="email" name="contact[email]" autocomplete="email" value="{{ form.email | default: customer.email | escape }}" required>
          </div>
          <div class="alley-contact__field">
            <label for="AlleyContactOrder">Order number <span>(optional)</span></label>
            <input id="AlleyContactOrder" type="text" name="contact[order_number]" autocomplete="off">
          </div>
          <div class="alley-contact__field">
            <label for="AlleyContactMessage">Message</label>
            <textarea id="AlleyContactMessage" name="contact[body]" rows="6" required>{{ form.body | escape }}</textarea>
          </div>
          <button class="m-button m-button--primary alley-contact__submit" type="submit">Send message</button>
        {% endform %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Alley Cat contact",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "Contact Alley Cat Trading"},
    {"type": "richtext", "id": "intro", "label": "Introduction", "default": "<p>Have a question about a find or an online order? Send our customer care team a message.</p>"},
    {"type": "text", "id": "phone", "label": "Phone number"},
    {"type": "textarea", "id": "postal_address", "label": "Postal address"},
    {"type": "text", "id": "hours", "label": "Online customer care hours"},
    {"type": "url", "id": "returns_url", "label": "Returns policy link"},
    {"type": "url", "id": "faq_url", "label": "FAQ link"}
  ],
  "presets": [{"name": "Alley Cat contact"}]
}
{% endschema %}
