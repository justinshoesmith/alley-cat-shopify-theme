<section class="alley-home-intro">
  <div class="alley-home-intro__inner">
    <p class="alley-home-intro__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h2>{{ section.settings.heading | escape }}</h2>
    <p class="alley-home-intro__descriptor">{{ section.settings.descriptor | escape }}</p>
    <div class="alley-home-intro__copy rte">{{ section.settings.copy }}</div>
    <div class="alley-home-intro__actions">
      {% if section.settings.primary_label != blank and section.settings.primary_link != blank %}
        <a class="m-button" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label | escape }}</a>
      {% endif %}
      {% if section.settings.secondary_label != blank and section.settings.secondary_link != blank %}
        <a class="m-button m-button--outline" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label | escape }}</a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Alley Cat home intro",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Alley Cat Trading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Thoughtful gifts. Timeless finds." },
    { "type": "text", "id": "descriptor", "label": "Descriptor", "default": "An independent online trading house." },
    { "type": "richtext", "id": "copy", "label": "Copy", "default": "<p>Distinctive pre-loved and vintage pieces, thoughtfully selected for character, condition and fair value.</p>" },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Shop new arrivals" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Explore pre-loved finds" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" }
  ],
  "presets": [
    { "name": "Alley Cat home intro" }
  ]
}
{% endschema %}
