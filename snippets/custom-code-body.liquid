{% doc %}
Loads the Alley Cat Trading support chat on storefront pages.
{% enddoc %}

{% if settings.act_enable_chatwoot %}
  <script>
    (function (d, t) {
      var baseUrl = 'https://support.alleycattrading.com.au';
      var script = d.createElement(t);
      var firstScript = d.getElementsByTagName(t)[0];

      script.src = baseUrl + '/packs/js/sdk.js';
      script.async = true;
      script.onload = function () {
        window.chatwootSDK.run({
          websiteToken: 'sJxoHAvUxhr86yHywGhyhAng',
          baseUrl: baseUrl
        });
      };

      firstScript.parentNode.insertBefore(script, firstScript);
    })(document, 'script');
  </script>
{% endif %}
