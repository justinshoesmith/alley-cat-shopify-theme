{%- if settings.use_favicon == true and settings.favicon != blank -%}
  <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
{%- endif -%}

{%- capture seo_title -%}
  {%- if request.page_type == 'search' and search.performed == true -%}
    {{ 'general.search.results_with_count' | t: terms: search.terms, count: search.results_count }}
  {%- elsif request.page_type == 'password' -%}
    {{ shop.name }} – {{ 'general.password_page.opening_soon' | t }}
  {%- elsif template == 'index' -%}
    Alley Cat Trading | Thoughtful Gifts. Timeless Finds.
  {%- else -%}
    {%- if page_title contains 'Alley Cat Trading' -%}
      {{ page_title }}
    {%- else -%}
      {{ page_title }} | Alley Cat Trading
    {%- endif -%}
  {%- endif -%}

  {%- if current_tags -%}
    {%- assign meta_tags = current_tags | join: ', ' -%}
    – {{ 'general.meta.tags' | t: tags: meta_tags }}
  {%- endif -%}

  {%- if current_page != 1 -%}
    – {{ 'general.meta.page' | t: page: current_page }}
  {%- endif -%}
{%- endcapture -%}

<title>{{ seo_title | strip }}</title>

{%- assign default_description = '' -%}

{%- if template == 'index' -%}
  {%- assign default_description = "Explore distinctive preloved and vintage pieces at Alley Cat Trading, an independent online trading house." -%}
{%- elsif template contains 'product' and product != blank -%}
  {%- assign default_description = product.title | append: " at Alley Cat Trading. Explore its condition, character and story online." -%}
{%- elsif template contains 'collection' and collection != blank -%}
  {%- assign default_description = collection.title | append: " – Shop distinctive preloved and vintage finds at Alley Cat Trading." -%}
{%- elsif template contains 'blog' -%}
  {%- assign default_description = "Stories, finds and notes from Alley Cat Trading, an independent online trading house." -%}
{%- elsif template contains 'article' and article != blank -%}
  {%- assign default_description = article.title | append: " – Read more from Alley Cat Trading." -%}
{%- else -%}
  {%- assign default_description = "Alley Cat Trading – thoughtful gifts and timeless preloved finds, available online across Australia." -%}
{%- endif -%}

{%- if page_description -%}
  <meta name="description" content="{{ page_description | escape }}">
{%- else -%}
  <meta name="description" content="{{ default_description | escape }}">
{%- endif -%}
